// slums.dll version resource, generated by src/CMakeLists.txt from cmake/BuildStamp.cmake (release and build).
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @SLUMS_VER_MAJOR@,@SLUMS_VER_MINOR@,@SLUMS_VER_PATCH@,@SLUMS_BUILD_NUMBER@
PRODUCTVERSION  @SLUMS_VER_MAJOR@,@SLUMS_VER_MINOR@,@SLUMS_VER_PATCH@,@SLUMS_BUILD_NUMBER@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SlumsMS"
            VALUE "FileDescription",  "SlumsMS client (based on Kaentake)"
            VALUE "FileVersion",      "@SLUMS_VER_MAJOR@.@SLUMS_VER_MINOR@.@SLUMS_VER_PATCH@.@SLUMS_BUILD_NUMBER@"
            VALUE "InternalName",     "slums"
            VALUE "OriginalFilename", "slums.dll"
            VALUE "ProductName",      "SlumsMS"
            VALUE "ProductVersion",   "@SLUMS_RELEASE@"
            VALUE "SlumsBuild",       "@SLUMS_BUILD_NUMBER@"
            VALUE "LegalCopyright",   "SlumsMS; Kaentake by its upstream authors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
